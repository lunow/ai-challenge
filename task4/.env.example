# Airport Resource Limits
RUNWAY_COUNT=2
GATE_COUNT=5
GROUND_CREW_COUNT=3

# Runway Separation Buffers (in minutes)
RUNWAY_BUFFER_TAKEOFF=2
RUNWAY_BUFFER_LANDING=3
RUNWAY_BUFFER_MIXED=5

# Gate and Dependency Buffers (in minutes)
GATE_TURNAROUND_TIME=45
DEPENDENCY_BUFFER_TIME=15

# Maximum Scheduling Horizon (in minutes, e.g. 1440 = 24 hours)
MAX_SCHEDULING_HORIZON=1440

# Optional Ground Crew Service Time (in minutes, defaults to 30)
GROUND_CREW_SERVICE_TIME=30
